<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <queries>
        <package android:name="com.dubox.drive"/>
    </queries>
    <application
        android:allowBackup="false"
        android:label="ATMACA Tera Kopyalayıcı"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false">
        <activity android:name=".FolderSelectActivity" android:exported="false"/>
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <service
            android:name=".ScreenIndexService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection"/>
        <service
            android:name=".FastDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync"/>
    </application>
</manifest>